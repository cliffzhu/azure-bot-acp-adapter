{
  "name": "azure-bot-acp-adapter",
  "version": "0.1.0",
  "private": true,
  "description": "Connect Azure Bot Service channels to remote ACP agents over authenticated WebSockets",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test",
    "report:messages": "node dist/getBotMessageReport.js",
    "report:messages:dev": "tsx src/getBotMessageReport.ts",
    "report:email": "node dist/sendBotMessageReportEmail.js",
    "report:email:dev": "tsx src/sendBotMessageReportEmail.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "botbuilder": "^4.23.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jose": "^5.10.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
