# Copy this file to .env and replace placeholders.
# Use NODE_ENV=development for local simulation endpoints (/api/simulate, /api/dev/messages).
# Use NODE_ENV=production to disable those dev endpoints in production.
NODE_ENV=development
PORT=3978
LOG_LEVEL=debug

# Azure AI Bot Service credentials (Azure App Registration)
MicrosoftAppType=SingleTenant
MicrosoftAppId=YOUR_BOT_APP_ID
MicrosoftAppPassword=YOUR_BOT_APP_PASSWORD
MicrosoftAppTenantId=YOUR_TENANT_ID

# Optional single-gate mode for incoming JWT authenticity verification.
# false: default CloudAdapter authentication on /api/messages.
# true: bypass CloudAdapter auth and use only JWT validation on /api/messages.
JWT_ONLY_AUTH_ENABLED=false
JWT_AUTH_REQUIRED_PATH_PREFIX=/api/messages
JWT_AUTH_HEADER=Authorization

# Required when JWT_ONLY_AUTH_ENABLED=true.
# Option A (provider-agnostic): set exact OpenID discovery URL + issuer allow-list.
OPENID_CONFIGURATION_URL=

# Option B (Azure shortcut): set tenant + token version to auto-build OpenID URL.
JWT_TENANT_ID=YOUR_TENANT_ID
JWT_TOKEN_VERSION=v2.0

# Always required in JWT-only mode: exact audience expected in incoming tokens.
JWT_EXPECTED_AUDIENCE=YOUR_EXPECTED_AUDIENCE

# Optional overrides for issuer list and verification behavior.
# Comma-separated issuer allow-list.
# Example for v2.0 + legacy issuer format:
# JWT_ALLOWED_ISSUERS=https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0,https://sts.windows.net/YOUR_TENANT_ID/
# If blank and JWT_TENANT_ID is set, Azure defaults are derived automatically.
JWT_ALLOWED_ISSUERS=
JWKS_CACHE_TTL_SECONDS=3600
JWT_CLOCK_SKEW_SECONDS=300

# Outgoing channel send logs (attempt/success/failure) for CloudAdapter paths.
# Set to false in production if you want less verbose logs.
OUTGOING_ACTIVITY_LOG_ENABLED=true

# Experimental progressive response mode.
# true: periodically send Bot Framework typing activities while backend chunks stream in.
# false: buffer the entire backend response and send a single final message.
# Note: Teams does not reliably support true token-by-token streaming UI.
STREAMING_RESPONSES_ENABLED=false

# Teams session-update preview detail.
# Diagnostic only: true forwards intermediate message/tool updates to Teams.
# Keep false to send only the final buffered response; typing indicators continue while waiting.
VERBOSE_SESSION_UPDATES=false

# WebSocket backend settings
WEBSOCKET_URL=wss://YOUR_BACKEND_HOST/ws
WEBSOCKET_AUTH_TOKEN=YOUR_BACKEND_TOKEN
# Optional default session config options applied after session/new.
# Preferred: set WEBSOCKET_AGENT_NAME when backend supports agent config.
WEBSOCKET_AGENT_NAME=
# Optional fallback for backends that expect model config instead of agent config.
WEBSOCKET_MODEL_NAME=
# Connection establishment timeout; must be > 0.
WEBSOCKET_CONNECT_TIMEOUT_MS=10000
# Per-RPC request timeout (initialize/session operations).
# Set to 0 to disable request timeout and wait indefinitely.
WEBSOCKET_MESSAGE_TIMEOUT_MS=30000
# Conversation session TTL (inactivity window) before forcing a new backend session.
WEBSOCKET_SESSION_TTL_MS=14400000
# Number of attempts to establish the initial WebSocket connection on server startup.
WEBSOCKET_STARTUP_MAX_ATTEMPTS=6
# Delay between initial connection attempts on server startup.
WEBSOCKET_STARTUP_RETRY_DELAY_MS=5000

# Optional local health endpoint
HEALTH_ENDPOINT_PATH=/healthz

# Azure resource naming (dev)
AZURE_LOCATION=eastus
AZURE_ENV=dev
AZURE_RESOURCE_GROUP=rg-yourprefix-bot-dev
AZURE_BOT_NAME=bot-yourprefix-dev
AZURE_CONTAINER_APP_NAME=ca-yourprefix-bot-dev
AZURE_CONTAINER_APPS_ENVIRONMENT=aca-yourprefix-bot-dev
AZURE_CONTAINER_REGISTRY=cryourprefixdev
AZURE_KEY_VAULT=kv-yourprefix-bot-dev
AZURE_LOG_ANALYTICS=log-yourprefix-bot-dev

# Optional: shared Azure Files mount for container writable paths.
# If any of these are set, all required values must be provided.
AZURE_FILE_STORAGE_NAME=appdata
AZURE_FILE_SHARE_NAME=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_FILE_ACCESS_MODE=ReadWrite

# Optional override for upstream mount root used by the startup remap wrapper.
# Default when unset: /appdata/upstream
UPSTREAM_APPDATA_ROOT=


#The app will parse those pairs and create the requested directory links on startup
ACP_SYMLINK_MAPPINGS=/app/logs=/appdata/bot/logs,/app/workspace=/appdata/upstream/workspace
# Interval for the in-memory prepared-session watchdog, which periodically
# probes the pooled warm session via session/resume and replaces it if the
# backend explicitly reports it gone (independent of any chat request or
# WebSocket reconnect). Purely in-memory - nothing is persisted to disk, so
# a full process/container restart simply starts a fresh pool.
# Default is 0 (disabled): session/resume is semantically meant for
# re-attaching a session across a reconnect, not for periodically pinging a
# session that is still sitting untouched in the pool - validation still
# runs automatically whenever a real WebSocket reconnect happens. Only set
# this if you also want proactive periodic probing between reconnects.
ACP_PREPARED_SESSION_WATCHDOG_INTERVAL_MS=0
# Optional warmup prompt for prepared sessions.
# If set, each newly created warm session runs this prompt before entering the pool.
WARMUP_SESSION_INITIAL_PROMPT=
# Backward-compatible alias (legacy typo) still supported:
WARMUP_SESSION_INITAL_PROMPT=Generate a compact knowledge map. For each topic include:- Topic name- Aliases may use - One-line summary- Source document- Section path- Confidence keywords; Limit output to 100 topics.Return JSON.
LOG_REPORT_DAYS=7
LOG_DIR=/appdata/bot/logs
MAIL_SENDER_ENDPOINT=
MAIL_SENDER_ENDPOINT_AUTHCODE=
MAIL_FROM_ADDRESS=
MAIL_TO_ADDRESS=